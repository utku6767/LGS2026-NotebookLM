# LGS Çözüm — örnek ortam dosyası
#
# Bu dosyayı .env olarak kopyala ve değerleri kendi sunucunla doldur.
# .env web'den okunamaz (.htaccess) ve sürüm kontrolüne girmez (.gitignore).
#
# Şifre: InfinityFree panel > MySQL Databases > (veritabanı) > Password
# Kontrol: https://<site>/setup.php

LGS_DB_HOST=example.com
LGS_DB_NAME=lgs
LGS_DB_USER=x
LGS_DB_PASS=x

# Gizli debug modu (Konami kodu: ↑ ↑ ↓ ↓ ← → ← → B A Enter).
# 1 = açık (varsayılan), 0 = kodu tamamen devre dışı bırakır.
# Debug modu yalnızca kodu giren oturumda geçerlidir; deneme süresini
# anında bitirme / kısaltma araçlarını açar.
LGS_DEBUG=1
